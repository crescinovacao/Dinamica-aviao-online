{
  "rules": {
    ".read": false,
    ".write": false,
    "aviao_sessions": {
      "$sc": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('meta/facilitatorId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['meta','planes'])",
        "meta": {
          ".validate": "newData.child('facilitatorId').val() === auth.uid && newData.child('numPlanes').isNumber() && newData.child('numPlanes').val() >= 1 && newData.child('numPlanes').val() <= 5"
        }
      }
    },
    "aviao": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('meta/facilitatorId').val() === auth.uid",
        "meta": {
          ".write": "auth != null && !data.exists() && newData.child('facilitatorId').val() === auth.uid",
          ".validate": "newData.hasChildren(['facilitatorId','numParticipants','planeVersion','createdAt']) && newData.child('numParticipants').isNumber() && newData.child('numParticipants').val() >= 6 && newData.child('numParticipants').val() <= 11 && newData.child('planeVersion').isNumber() && newData.child('planeVersion').val() >= 1 && newData.child('planeVersion').val() <= 5"
        },
        "state": {
          ".write": "auth != null && root.child('aviao/'+$code+'/meta/facilitatorId').val() === auth.uid",
          "phase": {
            ".write": "auth != null && root.child('aviao/'+$code+'/participants/'+auth.uid+'/role').val() === 'A' && root.child('aviao/'+$code+'/state/phase').val() === 'playing' && newData.val() === 'ended'",
            ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'ended'"
          },
          "answer": {
            ".write": "auth != null && root.child('aviao/'+$code+'/participants/'+auth.uid+'/role').val() === 'A' && root.child('aviao/'+$code+'/state/phase').val() === 'playing' && !data.exists()",
            ".validate": "newData.val() === null || newData.val() === 'amp' || newData.val() === 'fem' || newData.val() === 'pro' || newData.val() === 'sor' || newData.val() === 'pct' || newData.val() === 'mas'"
          },
          "correct": {
            ".write": "auth != null && root.child('aviao/'+$code+'/participants/'+auth.uid+'/role').val() === 'A' && root.child('aviao/'+$code+'/state/phase').val() === 'playing' && !data.exists()",
            ".validate": "newData.val() === null || newData.isBoolean()"
          },
          "answeredBy": {
            ".write": "auth != null && root.child('aviao/'+$code+'/participants/'+auth.uid+'/role').val() === 'A' && root.child('aviao/'+$code+'/state/phase').val() === 'playing' && !data.exists()",
            ".validate": "newData.val() === null || newData.val() === 'A'"
          },
          "revealed": {
            ".validate": "newData.isBoolean()"
          }
        },
        "participants": {
          "$uid": {
            ".write": "auth != null && (root.child('aviao/'+$code+'/meta/facilitatorId').val() === auth.uid || ($uid === auth.uid && newData.child('role').val() === data.child('role').val() && newData.child('symbols').exists() === data.child('symbols').exists() && (data.exists() || root.child('aviao/'+$code+'/state/phase').val() === 'lobby')))",
            ".validate": "newData.hasChildren(['name','connectedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "connectedAt": {
              ".validate": "newData.isNumber()"
            },
            "role": {
              ".validate": "newData.val() === null || newData.val() === 'A' || newData.val() === 'B1' || newData.val() === 'B2' || newData.val() === 'C' || newData.val() === 'D' || newData.val() === 'E' || newData.val() === 'F' || newData.val() === 'G' || newData.val() === 'H' || newData.val() === 'I' || newData.val() === 'J'"
            },
            "symbols": {
              ".validate": "newData.hasChildren() && !newData.child('5').exists()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "messages": {
          ".indexOn": [
            "ts"
          ],
          "$mid": {
            ".write": "auth != null && !data.exists() && newData.child('fromUid').val() === auth.uid && root.child('aviao/'+$code+'/participants/'+auth.uid+'/role').val() === newData.child('fromRole').val() && root.child('aviao/'+$code+'/state/phase').val() === 'playing'",
            ".validate": "newData.hasChildren(['fromUid','fromRole','toRole','text','ts']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500",
            "$other": {
              ".validate": "$other === 'fromUid' || $other === 'fromRole' || $other === 'fromName' || $other === 'toRole' || $other === 'text' || $other === 'ts'"
            }
          }
        }
      }
    }
  }
}